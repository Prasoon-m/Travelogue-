# ========================================================
# Travelogue Production Environment Variables for VPS
# ========================================================

# --- Backend Configuration ---
PORT=4000
NODE_ENV=production

# SQLite database file path inside container volume
DATABASE_URL="file:/app/prisma/dev.db"

# Secure random JWT secret for token signing (Change to your own secure random key)
JWT_SECRET="travelogue_prod_jwt_secret_change_me_in_production"

# AES-256-GCM symmetric encryption key (Must be exactly 32 bytes / 32 characters)
ENCRYPTION_KEY="travelogue_32_byte_aes_key_prod!"

# Allowed frontend origins for CORS (comma-separated, your actual domains)
FRONTEND_ORIGINS="https://travelogue.yourdomain.com,http://localhost:3000"

# Optional salt for OTP hashing (defaults to JWT_SECRET if unset)
OTP_SECRET="travelogue_prod_otp_secret_salt_2026"

# --- Frontend Configuration ---
# Public backend API URL that the user's browser calls
NEXT_PUBLIC_API_BASE="https://api.travelogue.yourdomain.com/api"
